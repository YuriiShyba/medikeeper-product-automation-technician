# Provisioned UI account for the manual authenticated quality gate only.
CYPRESS_AUTH_USERNAME=<PROVISIONED_AUTOMATION_USERNAME>
CYPRESS_AUTH_PASSWORD=<PROVISIONED_AUTOMATION_PASSWORD>
CYPRESS_AUTH_MFA_CODE=<CONTROLLED_MFA_VALUE>
CYPRESS_AUTH_MFA_INPUT_SELECTOR=<PROVISIONED_MFA_INPUT_SELECTOR>
CYPRESS_AUTH_MFA_SUBMIT_SELECTOR=<PROVISIONED_MFA_SUBMIT_SELECTOR>
CYPRESS_AUTHENTICATED_STATE_SELECTOR=<PROVISIONED_AUTHENTICATED_STATE_SELECTOR>
CYPRESS_LAST_LOGIN_UPDATE_TIMEOUT_MS=2000

# Backend adapter contract. No database technology or schema is assumed.
TAKEHOME_DB_ADAPTER=<IMPLEMENTED_ADAPTER_NAME>
TAKEHOME_DB_CONNECTION=<SECRET_CONNECTION_CONFIGURATION>
